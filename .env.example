# Server
PORT=3000
HOST=127.0.0.1

# Data Directory (relative to project root or absolute)
DATA_DIR=./data

# AI Provider Keys (can also be configured via UI)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# DEEPSEEK_API_KEY=...
# OPENROUTER_API_KEY=...
# 后端配置（Wave5 补全）
# 本地认证 token 相关（自动生成，无需手动设置）
# ENCRYPTION_KEY= <32字节hex；若未设置将在首次启动自动生成并存入 OS 钥匙串(Windows DPAPI)>

# 移动端同步（Supabase）— 桌面端作为中继，仅需 URL 与 Key 其中之一从 UI 配置
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIs...

# 特性开关
# ENABLE_SWAGGER=true   # 仅开发环境开启 /docs（生产默认关闭）
# ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
