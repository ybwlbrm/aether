{
    "name":  "aether",
    "version":  "2.1.0",
    "private":  true,
    "description":  "Aether — 本地优先的 AI 工作操作系统",
    "main":  "electron/main.js",
    "workspaces":  [
                       "src/shared",
                       "src/backend",
                       "src/frontend",
                       "src/mobile"
                   ],
    "scripts":  {
                    "dev":  "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
                    "dev:backend":  "npm run dev -w src/backend",
                    "dev:frontend":  "npm run dev -w src/frontend",
                    "build":  "npm run build:clean \u0026\u0026 npm run build -w src/shared \u0026\u0026 npm run build -w src/backend \u0026\u0026 npm run build -w src/frontend",
                    "build:clean":  "node -e \"const fs=require(\u0027fs\u0027); for (const f of [\u0027tsconfig.tsbuildinfo\u0027,\u0027src/shared/tsconfig.tsbuildinfo\u0027,\u0027src/backend/tsconfig.tsbuildinfo\u0027,\u0027src/frontend/tsconfig.tsbuildinfo\u0027]) fs.rmSync(f,{force:true})\"",
                    "build:backend":  "npm run build -w src/backend",
                    "build:frontend":  "npm run build -w src/frontend",
                    "build:mobile":  "npm run build -w src/mobile",
                    "build:apk":  "npm run build -w src/mobile \u0026\u0026 npx cap sync android \u0026\u0026 cd android \u0026\u0026 gradlew.bat assembleRelease",
                    "test":  "npm run build -w src/shared \u0026\u0026 npm run build -w src/backend \u0026\u0026 npm run test -w src/shared \u0026\u0026 npm run test -w src/backend \u0026\u0026 npm run test -w src/frontend",
                    "test:backend":  "npm run test -w src/backend",
                    "test:frontend":  "npm run test -w src/frontend",
                    "lint":  "eslint src/ --ext .ts,.tsx",
                    "typecheck":  "tsc --noEmit -p src/shared \u0026\u0026 tsc --noEmit --composite false -p src/backend \u0026\u0026 tsc --noEmit --composite false -p src/frontend",
                    "clean":  "node -e \"const fs=require(\u0027fs\u0027); for (const d of [\u0027src/shared/dist\u0027,\u0027src/backend/dist\u0027,\u0027src/frontend/dist\u0027,\u0027src/mobile/dist\u0027,\u0027dist_electron\u0027]) fs.rmSync(d, { recursive: true, force: true }); for (const f of [\u0027tsconfig.tsbuildinfo\u0027,\u0027src/shared/tsconfig.tsbuildinfo\u0027,\u0027src/backend/tsconfig.tsbuildinfo\u0027,\u0027src/frontend/tsconfig.tsbuildinfo\u0027]) fs.rmSync(f, { force: true })\"",
                    "start":  "npm run start -w src/backend",
                    "bundle:backend":  "node build/bundle-backend.js",
                    "build:exe":  "node build/build-exe.js",
                    "build:icon":  "node build/generate-icon.js \u0026\u0026 node build/gen-icon.js \u0026\u0026 node build/make-ico.js",
                    "build:liquid-map":  "node build/gen-liquid-map.js",
                    "electron:dev":  "electron ."
                },
    "devDependencies":  {
                            "@types/node":  "^22.12.0",
                            "@typescript-eslint/eslint-plugin":  "^8.67.0",
                            "@typescript-eslint/parser":  "^8.67.0",
                            "concurrently":  "^9.1.2",
                            "electron":  "^43.3.0",
                            "electron-builder":  "^25.1.8",
                            "esbuild":  "^0.25.0",
                            "eslint":  "^9.18.0",
                            "typescript":  "^5.7.3"
                        },
    "dependencies":  {
                         "@capacitor/android":  "^8.5.0",
                         "@capacitor/cli":  "^8.5.0",
                         "@capacitor/core":  "^8.5.0",
                         "@fastify/cors":  "^10.1.0",
                         "@fastify/static":  "^9.3.0",
                         "@fastify/swagger":  "^9.4.2",
                         "@fastify/swagger-ui":  "^5.2.2",
                         "@modelcontextprotocol/sdk":  "^1.30.0",
                         "@napi-rs/canvas":  "^0.1.65",
                         "@supabase/supabase-js":  "^2.112.3",
                         "docx":  "^9.7.1",
                         "drizzle-orm":  "^0.45.2",
                         "eventsource-parser":  "^3.1.1",
                         "fastify":  "^5.2.1",
                         "iconv-lite":  "^0.6.3",
                         "koffi":  "^3.1.4",
                         "pdf-lib":  "^1.17.1",
                         "pdfjs-dist":  "^4.10.38",
                         "pino":  "^9.6.0",
                         "pino-pretty":  "^13.0.0",
                         "playwright":  "^1.62.1",
                         "pptxgenjs":  "^4.0.1",
                         "sharp":  "^0.33.5",
                         "sql.js":  "^1.14.1",
                         "xlsx":  "^0.18.5",
                         "zod":  "^3.24.2"
                     }
}